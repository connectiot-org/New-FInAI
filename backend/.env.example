# Run npm run db:init to create a private local .env. Never use local identity publicly.
NODE_ENV=development
CHECKLIST_IDENTITY=local
API_HOST=127.0.0.1
API_PORT=3000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATABASE_URL and POSTGRES_PASSWORD generated by db:init (local infrastructure only).

# Assistant settings belong on the backend host, not only the Vercel frontend.
# Keep disabled until approved model/provider/privacy/budget settings are supplied.
ASSISTANT_ENABLED=false
OPENROUTER_API_KEY=
# Existing server variable Openrouter is also accepted; canonical name takes precedence.
ASSISTANT_MODEL=
ASSISTANT_OPENROUTER_PROVIDERS=
ASSISTANT_DAILY_TOKEN_LIMIT=
# Explicit USD per million tokens; use 0 for BOTH caps to prohibit paid routing.
ASSISTANT_MAX_INPUT_PRICE=
ASSISTANT_MAX_OUTPUT_PRICE=
ASSISTANT_LEDGER_MAPPING_IDS=
