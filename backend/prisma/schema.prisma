generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id          String       @id @db.Uuid
  name        String       @db.VarChar(200)
  entities    Entity[]
  memberships Membership[]
  sessions Session[]
}

model User {
  id          String       @id @db.Uuid
  memberships Membership[]
  account Account?
}

model Membership {
  organisationId String         @map("organisation_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  active         Boolean        @default(true)
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  access         EntityAccess[]

  @@id([organisationId, userId])
}

model Entity {
  id             String          @id @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  name           String          @db.VarChar(200)
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  access         EntityAccess[]
  tasks          ChecklistTask[]
  subscriptions SubscriptionRenewal[]

  @@unique([organisationId, id])
}

model EntityAccess {
  organisationId String     @map("organisation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  entityId       String     @map("entity_id") @db.Uuid
  canWrite       Boolean    @default(false) @map("can_write")
  membership     Membership @relation(fields: [organisationId, userId], references: [organisationId, userId])
  entity         Entity     @relation(fields: [organisationId, entityId], references: [organisationId, id])

  @@id([organisationId, userId, entityId])
}

model ChecklistTask {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  month          DateTime @db.Date
  title          String   @db.VarChar(200)
  completed      Boolean  @default(false)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createDigest   String   @map("create_digest") @db.Char(64)
  entity         Entity   @relation(fields: [organisationId, entityId], references: [organisationId, id])

  @@index([organisationId, entityId, month, createdAt, id])
}

model Account {
  userId String @id @db.Uuid
  username String @unique @db.VarChar(100)
  passwordHash String
  disabled Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions Session[]
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  organisationId String @db.Uuid
  csrfHash String @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId])
  @@index([expiresAt])
}
model RateLimit {
  key String @id @db.Char(64)
  window DateTime @db.Timestamptz(3)
  count Int
}

model SubscriptionRenewal {
  id String @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  supplierName String @db.VarChar(200)
  subscriptionName String @db.VarChar(200)
  renewalDate DateTime @db.Date
  cancellationDeadline DateTime? @db.Date
  notes String? @db.VarChar(2000)
  archived Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  entity Entity @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([organisationId, entityId, archived, renewalDate, id], map: "SubscriptionRenewal_organisation_id_entity_id_archived_renewal_")
}
