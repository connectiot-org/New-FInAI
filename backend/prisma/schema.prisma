generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id          String       @id @db.Uuid
  name        String       @db.VarChar(200)
  entities    Entity[]
  memberships Membership[]
  sessions Session[]
  auditEvents ServerAudit[]
  importStages ReceivableImportStage[]
}

model User {
  id          String       @id @db.Uuid
  memberships Membership[]
  account Account?
  receivableImports ReceivableSnapshot[]
  auditEvents ServerAudit[]
  importStages ReceivableImportStage[]
}

model Membership {
  organisationId String         @map("organisation_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  active         Boolean        @default(true)
  isAdministrator Boolean @default(false) @map("is_administrator")
  version Int @default(1)
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  access         EntityAccess[]

  @@id([organisationId, userId])
}

model Entity {
  id             String          @id @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  name           String          @db.VarChar(200)
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  access         EntityAccess[]
  tasks          ChecklistTask[]
  subscriptions SubscriptionRenewal[]
  receivableSnapshots ReceivableSnapshot[]
  auditEvents ServerAudit[]
  importStages ReceivableImportStage[]

  @@unique([organisationId, id])
}

model EntityAccess {
  organisationId String     @map("organisation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  entityId       String     @map("entity_id") @db.Uuid
  canWrite       Boolean    @default(false) @map("can_write")
  canImport Boolean @default(false) @map("can_import")
  version Int @default(1)
  membership     Membership @relation(fields: [organisationId, userId], references: [organisationId, userId])
  entity         Entity     @relation(fields: [organisationId, entityId], references: [organisationId, id])

  @@id([organisationId, userId, entityId])
}

model ChecklistTask {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  month          DateTime @db.Date
  title          String   @db.VarChar(200)
  completed      Boolean  @default(false)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createDigest   String   @map("create_digest") @db.Char(64)
  entity         Entity   @relation(fields: [organisationId, entityId], references: [organisationId, id])

  @@index([organisationId, entityId, month, createdAt, id])
}

model Account {
  userId String @id @db.Uuid
  username String @unique @db.VarChar(100)
  passwordHash String
  disabled Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions Session[]
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  organisationId String @db.Uuid
  csrfHash String @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId])
  @@index([expiresAt])
}
model RateLimit {
  key String @id @db.Char(64)
  window DateTime @db.Timestamptz(3)
  count Int
}

model SubscriptionRenewal {
  id String @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  supplierName String @db.VarChar(200)
  subscriptionName String @db.VarChar(200)
  renewalDate DateTime @db.Date
  cancellationDeadline DateTime? @db.Date
  notes String? @db.VarChar(2000)
  archived Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  entity Entity @relation(fields: [organisationId, entityId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  @@index([organisationId, entityId, archived, renewalDate, id], map: "SubscriptionRenewal_organisation_id_entity_id_archived_renewal_")
}

model ReceivableSnapshot {
 id String @id @db.Uuid
 organisationId String @map("organisation_id") @db.Uuid
 entityId String @map("entity_id") @db.Uuid
 version Int
 sourceName String @map("source_name") @db.VarChar(200)
 sourceCapturedAt DateTime @map("source_captured_at") @db.Timestamptz(3)
 importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
 importingActorId String @map("importing_actor_id") @db.Uuid
 digest String @db.Char(64)
 rowCount Int @map("row_count")
 entity Entity @relation(fields:[organisationId,entityId],references:[organisationId,id],onDelete:NoAction,onUpdate:NoAction)
 actor User @relation(fields:[importingActorId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 invoices ReceivableSnapshotInvoice[]
 @@unique([organisationId,entityId,version],map:"receivable_version")
 @@unique([organisationId,entityId,digest],map:"receivable_digest")
 @@unique([organisationId,entityId,id],map:"receivable_scope")
}
model ReceivableSnapshotInvoice {
 organisationId String @map("organisation_id") @db.Uuid
 entityId String @map("entity_id") @db.Uuid
 snapshotId String @map("snapshot_id") @db.Uuid
 invoiceId String @map("invoice_id") @db.VarChar(200)
 customerId String @map("customer_id") @db.VarChar(200)
 customerName String? @map("customer_name") @db.VarChar(200)
 issuedOn DateTime @map("issued_on") @db.Date
 status String @db.VarChar(10)
 amountCents BigInt @map("amount_cents")
 paidCents BigInt @map("paid_cents")
 snapshot ReceivableSnapshot @relation(fields:[organisationId,entityId,snapshotId],references:[organisationId,entityId,id],onDelete:NoAction,onUpdate:NoAction)
 @@id([organisationId,entityId,snapshotId,invoiceId],map:"receivable_invoice_pk")
 @@index([organisationId,entityId,snapshotId,issuedOn,customerId],map:"receivable_invoice_scope_date")
}

model ServerAudit {
 id String @id @db.Uuid
 organisationId String @map("organisation_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 entityId String? @map("entity_id") @db.Uuid
 requestId String @map("request_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 action String @db.VarChar(64)
 reference String @db.VarChar(100)
 outcome String @db.VarChar(20)
 metadata Json @db.JsonB
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 actor User @relation(fields:[actorId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 entity Entity? @relation(fields:[organisationId,entityId],references:[organisationId,id],onDelete:NoAction,onUpdate:NoAction)
 @@index([organisationId,createdAt,id],map:"audit_organisation_time")
}
model ReceivableImportStage {
 id String @id @db.Uuid
 organisationId String @map("organisation_id") @db.Uuid
 entityId String @map("entity_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 sessionHash String @map("session_hash") @db.Char(64)
 expectedVersion Int @map("expected_version")
 nextVersion Int @map("next_version")
 digest String @db.Char(64)
 content Bytes
 rowCount Int @map("row_count")
 invoiceCount Int @map("invoice_count")
 customerCount Int @map("customer_count")
 totalCents BigInt @map("total_cents")
 sourceName String @map("source_name") @db.VarChar(200)
 sourceCapturedAt DateTime @map("source_captured_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 appliedVersion Int? @map("applied_version")
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 actor User @relation(fields:[actorId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 entity Entity @relation(fields:[organisationId,entityId],references:[organisationId,id],onDelete:NoAction,onUpdate:NoAction)
 @@index([organisationId,actorId,expiresAt],map:"import_stage_actor_expiry")
}
