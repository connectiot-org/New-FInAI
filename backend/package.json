{
  "name": "finai-checklist-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "start": "node --env-file=.env dist/src/main.js",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "db:init": "node scripts/init-local.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "generate": "prisma generate",
    "test": "node --env-file=.env --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
