{
  "name": "finai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:product",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests docs *.ts *.js *.json *.html README.md",
    "test:checklist": "playwright test --config playwright.checklist.config.ts",
    "test:session": "VITE_APP_MODE=product VITE_CHECKLIST_MODE=api VITE_AUTH_MODE=session VITE_API_BASE_URL=/api/v1 vite build --outDir artifacts/session-dist && playwright test --config playwright.session.config.ts",
    "test:subscriptions": "playwright test --config playwright.subscriptions.config.ts",
    "test:payment-due-date": "playwright test --config playwright.payment-due-date.config.ts",
    "build:product": "tsc -b && VITE_APP_MODE=product VITE_AUTH_MODE=session VITE_CHECKLIST_MODE=api VITE_API_BASE_URL=/api/v1 vite build",
    "test:proxy": "node --test scripts/proxy.test.ts scripts/session.test.ts",
    "check:product": "node scripts/check-product-build.ts && node scripts/check-assets.ts",
    "test:invoice-duplicates": "playwright test --config playwright.invoice-duplicates.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  }
}
