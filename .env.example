# FinAI — environment variable inventory (names only, values empty).
# This file documents every variable name read by the repository. It is
# documentation: nothing in the repo loads a root-level .env.
# Local API development uses backend/.env (see backend/.env.example and
# `npm run db:init` in backend/). Hosting secrets belong in Vercel/project
# settings, never in Git.

# ---- Backend (NestJS API; backend/.env.example is the local template) ----
NODE_ENV=
# "local" for loopback development, "session" for authenticated production
CHECKLIST_IDENTITY=
API_HOST=
API_PORT=
# Comma-separated exact local HTTP origins (dev only)
FRONTEND_ORIGINS=
# Generated by backend `npm run db:init` locally; supplied by hosting in prod
DATABASE_URL=
POSTGRES_PASSWORD=
# Session (production) mode only
PUBLIC_ORIGIN=
API_TRUSTED_HOST=
API_PROXY_TOKEN=
ORGANISATION_TIMEZONES=

# ---- Assistant (server runtime only; disabled by default) ----
ASSISTANT_ENABLED=
OPENROUTER_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_OPENROUTER_PROVIDERS=
ASSISTANT_DAILY_TOKEN_LIMIT=
ASSISTANT_MAX_INPUT_PRICE=
ASSISTANT_MAX_OUTPUT_PRICE=
ASSISTANT_LEDGER_MAPPING_IDS=

# ---- Payables document scanning (optional private ClamAV endpoint) ----
AP_CLAMD_HOST=
AP_CLAMD_PORT=

# ---- Vercel functions (frontend/api/proxy.ts, frontend/server/) ----
FINAI_API_MODE=
FINAI_BACKEND_ORIGIN=
FINAI_PROXY_TOKEN=
FINAI_PUBLIC_ORIGIN=

# ---- Frontend build-time (Vite; safe, non-secret) ----
VITE_API_BASE_URL=
VITE_AUTH_MODE=
VITE_CHECKLIST_MODE=
VITE_RECEIVABLES_MODE=
