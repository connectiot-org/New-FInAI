{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finai.example/contracts/public-chat/1.0.0",
  "$defs": {
    "ModelId": { "type": "string", "pattern": "^[a-zA-Z0-9._:/-]{1,200}$" },
    "Models": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "retrievedAt", "configured", "freeOnly"],
      "properties": {
        "items": { "type": "array", "maxItems": 1000, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name"],
          "properties": { "id": { "$ref": "#/$defs/ModelId" }, "name": { "type": "string", "minLength": 1, "maxLength": 200 } }
        } },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "configured": { "type": "boolean" }, "freeOnly": { "const": true }
      }
    },
    "Message": {
      "type": "object", "additionalProperties": false, "required": ["role", "content"],
      "properties": { "role": { "enum": ["user", "assistant"] }, "content": { "type": "string", "minLength": 1, "maxLength": 4000 } }
    },
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["model", "messages"],
      "properties": {
        "model": { "$ref": "#/$defs/ModelId" },
        "messages": { "type": "array", "minItems": 1, "maxItems": 11, "items": { "$ref": "#/$defs/Message" } }
      }
    },
    "Answer": {
      "type": "object", "additionalProperties": false, "required": ["selectedModel", "model", "content"],
      "properties": {
        "selectedModel": { "$ref": "#/$defs/ModelId" }, "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 100000 }
      }
    }
  }
}
