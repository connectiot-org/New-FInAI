{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finai:assistant:1.1.0",
  "$defs": {
    "ConversationCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityId",
        "month",
        "currency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "month": {
          "type": "string",
          "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "TurnCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "expectedVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
        }
      }
    },
    "PreferenceWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "detail",
        "note",
        "expectedVersion"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "detail": {
          "enum": [
            "concise",
            "detailed"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "unit",
        "currency",
        "precision",
        "sourceId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "unit": {
          "enum": [
            "text",
            "minor",
            "count"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "sourceId": {
          "type": "string"
        },
        "recordId": {
          "type": "string",
          "maxLength": 200
        },
        "recordKind": {
          "enum": [
            "customer",
            "account"
          ]
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "href",
        "basis",
        "capturedAt",
        "importedAt",
        "retrievedAt",
        "version",
        "snapshotId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "pattern": "^/workspace/"
        },
        "basis": {
          "type": "string"
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "importedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "period",
              "customerId",
              "metric",
              "reason",
              "accountId"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "receivables",
                  "invoices",
                  "checklist",
                  "subscriptions",
                  "ledger",
                  "clarify",
                  "unsupported"
                ]
              },
              "period": {
                "enum": [
                  "current",
                  "previous"
                ]
              },
              "customerId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "metric": {
                "enum": [
                  "all",
                  "cash",
                  "revenue",
                  "expense",
                  "profit",
                  "receivable",
                  "assets",
                  "equity"
                ]
              },
              "reason": {
                "enum": [
                  "none",
                  "ambiguous",
                  "unsupported",
                  "missing_ledger",
                  "scope_change"
                ]
              },
              "accountId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "Composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factIds",
        "noteIds"
      ],
      "properties": {
        "factIds": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "noteIds": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "sources",
        "notes",
        "basis",
        "detail"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": "string"
        },
        "detail": {
          "enum": [
            "concise",
            "detailed"
          ]
        }
      }
    },
    "Conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityId",
        "month",
        "currency",
        "version",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "month": {
          "type": "string",
          "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "status",
        "answer",
        "failureCode",
        "model",
        "policy",
        "createdAt",
        "finishedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "question": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Answer"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "ConversationRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityId",
        "month",
        "currency",
        "version",
        "createdAt",
        "expiresAt",
        "offset",
        "limit",
        "total",
        "turns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "month": {
          "type": "string",
          "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "turns": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Turn"
          }
        }
      }
    },
    "ConversationList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "limit",
        "total",
        "items"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Conversation"
          }
        }
      }
    },
    "TurnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationVersion",
        "turn"
      ],
      "properties": {
        "conversationVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "turn": {
          "$ref": "#/$defs/Turn"
        }
      }
    },
    "Preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityId",
        "detail",
        "note",
        "version",
        "createdAt",
        "updatedAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "detail": {
          "enum": [
            "concise",
            "detailed"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/Preference"
          }
        }
      }
    },
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion"
      ],
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "Forget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "expectedVersion"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "Saved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "Deleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "deleted"
        }
      }
    },
    "Forgotten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "forgotten"
        }
      }
    },
    "Cancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "cancelled"
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "ledgerMappingsEnabled",
        "model",
        "policy",
        "limits"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "ledgerMappingsEnabled": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversations",
            "turns",
            "questionCharacters",
            "leaseSeconds",
            "conversationDays",
            "preferenceDays",
            "maxTools",
            "tokenReservation"
          ],
          "properties": {
            "conversations": {
              "type": "integer",
              "minimum": 0
            },
            "turns": {
              "type": "integer",
              "minimum": 0
            },
            "questionCharacters": {
              "type": "integer",
              "minimum": 0
            },
            "leaseSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "conversationDays": {
              "type": "integer",
              "minimum": 0
            },
            "preferenceDays": {
              "type": "integer",
              "minimum": 0
            },
            "maxTools": {
              "type": "integer",
              "minimum": 0
            },
            "tokenReservation": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "requestId"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "fieldErrors": {
          "type": "array"
        }
      }
    },
    "OperationalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "month",
        "kind",
        "retrievedAt",
        "basis",
        "offset",
        "limit",
        "total",
        "nextOffset",
        "items"
      ],
      "properties": {
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "month": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "checklist",
            "subscriptions"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "basis": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "completed",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string"
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "supplierName",
                  "subscriptionName",
                  "renewalDate",
                  "cancellationDeadline",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "supplierName": {
                    "type": "string"
                  },
                  "subscriptionName": {
                    "type": "string"
                  },
                  "renewalDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "cancellationDeadline": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "ModelList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "retrievedAt",
        "defaultModel",
        "freeOnly"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "defaultModel": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:/-]{1,200}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "freeOnly": {
          "const": true
        }
      }
    }
  }
}
